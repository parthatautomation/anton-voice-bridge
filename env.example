# Anton Automation — Voice Bridge Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.
# NEVER paste these values in chat.

# Your Sarvam AI API key from dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key-here

# The public WebSocket URL of THIS service once deployed on Railway.
# Replace with your actual Railway URL after deployment.
# Format: wss://YOUR-APP-NAME.up.railway.app/stream
PUBLIC_WS_URL=wss://your-service.up.railway.app/stream

# Your existing n8n callback webhook — do not change this
N8N_CALLBACK_URL=https://workflow.parthkalyani.in/webhook/anton-call-callback

# Supabase project details
SUPABASE_URL=https://xpohqmchwutevucmsloi.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
